{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xbox002000/second-civilization/schemas/content-package.schema.json",
  "title": "Second Civilization Public Content Package",
  "type": "object",
  "required": ["content_id", "format", "working_title", "status", "canon_status"],
  "properties": {
    "content_id": {"type": "string", "pattern": "^CNT-[0-9]{8}-[0-9]{3}$"},
    "event_id": {"type": ["string", "null"], "pattern": "^EVT-[0-9]{8}-[0-9]{3}$"},
    "series_id": {"type": ["string", "null"]},
    "format": {"enum": ["reality_brief", "forecast", "event_fiction", "main_canon", "short_drama", "public_dialogue", "social_post", "longform", "novel_chapter"]},
    "working_title": {"type": "string", "minLength": 1},
    "logline": {"type": "string"},
    "audience_question": {"type": "string"},
    "platform_targets": {"type": "array", "items": {"type": "string"}},
    "canon_status": {"enum": ["CANON", "NON_CANON", "NOT_APPLICABLE"]},
    "fact_references": {"type": "array", "items": {"type": "string"}},
    "fictional_elements": {"type": "array", "items": {"type": "string"}},
    "prediction_id": {"type": ["string", "null"]},
    "data_cutoff_at": {"type": ["string", "null"], "format": "date-time"},
    "human_approval": {"type": "boolean"},
    "status": {"enum": ["DRAFT", "REVIEW", "HUMAN_APPROVAL", "APPROVED", "REJECTED", "PUBLISHED"]}
  },
  "additionalProperties": true
}